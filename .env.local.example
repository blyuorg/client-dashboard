# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with "sb_publishable_"). The legacy anon JWT
# ("eyJ...") also still works as a drop-in alternative.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Only needed for server-side admin actions (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
