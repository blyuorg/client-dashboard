# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings > API
#
# Local dev runs on http://localhost:8000 (see package.json "dev" script) —
# make sure http://localhost:8000/auth/callback is added under Supabase
# Authentication > URL Configuration > Redirect URLs.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with "sb_publishable_"). The legacy anon JWT
# ("eyJ...") also still works as a drop-in alternative.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Only needed for server-side admin actions (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay test or live credentials. Keep the secret server-only; never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------
# Meeting scheduler (Settings → Integrations, /meetings)
# ------------------------------------------------------------------
# Random passphrase (32+ chars) used to encrypt stored OAuth tokens at
# rest (AES-256-GCM). Generate one with: openssl rand -base64 32
# Rotating this makes every already-stored token undecryptable — treat it
# like any other long-lived secret, not something to change casually.
TOKEN_ENCRYPTION_KEY=

# Google Cloud Console → APIs & Services → Credentials. Enable the Google
# Calendar API first. Redirect URI must exactly match what's registered
# there — see the app's README/setup notes for local vs. production values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Zoom App Marketplace → Develop → Build App → OAuth.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/integrations/zoom/callback

# Microsoft Entra admin center → App registrations. MICROSOFT_TENANT_ID
# can be left as "common" for multi-tenant/personal accounts, or set to
# your specific tenant ID for a single-tenant app registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback
